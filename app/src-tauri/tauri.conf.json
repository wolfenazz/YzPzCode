{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YzPzCode",
  "version": "5.9.7",
  "identifier": "com.yzpzcode.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8745",
    "beforeBuildCommand": "npm run build && npm run build:agent",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YzPzCode",
        "width": 1200,
        "height": 800,
        "minWidth": 1020,
        "minHeight": 810,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "fileAssociations": [
      {
        "ext": [
          "txt", "md", "markdown", "json", "jsonc", "yaml", "yml", "toml", "xml", "csv",
          "ts", "tsx", "js", "jsx", "mjs", "cjs", "css", "scss", "sass", "less", "html", "htm",
          "rs", "py", "pyw", "go", "java", "c", "h", "cpp", "cc", "cxx", "hpp", "cs", "rb", "php",
          "swift", "kt", "kts", "lua", "sh", "bash", "zsh", "fish", "ps1", "psm1", "bat", "cmd", "sql",
          "graphql", "gql", "vue", "svelte", "astro", "zig", "dart", "ex", "exs", "erl", "hrl", "fs", "fsx",
          "vb", "gradle", "properties", "ini", "cfg", "conf", "env", "log", "diff", "patch", "gitignore",
          "editorconfig", "svg", "png", "jpg", "jpeg", "gif", "webp", "bmp", "ico", "avif", "tiff", "tif",
          "pdf", "docx", "doc", "xlsx", "xls", "pptx", "ppt", "drawio", "dio"
        ],
        "name": "YzPzCode supported file",
        "description": "Source code, text, document, or media file",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp"
      }
    },
    "resources": {
      "../agent-harness/dist": "agent-harness/dist",
      "../agent-harness/src": "agent-harness/src",
      "../agent-harness/package.json": "agent-harness/package.json",
      "../agent-harness/tsconfig.json": "agent-harness/tsconfig.json",
      "../agent-harness/node_modules": "agent-harness/node_modules"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDQzQwNDQ0NkI0NDk2MTMKUldRVGxrUnJSQVRFek9ER0lpQlQ5UG1RVTdxaWNHQlQyNDFxMmdkNGpKTVFPOFE3b2NrWXlGcWwK",
      "endpoints": [
        "https://github.com/wolfenazz/YzPzCode/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
